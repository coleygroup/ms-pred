[Unit]
Description=iceberg atlas webui (Gunicorn)
After=network.target

[Service]
Type=simple
User=USER
Group=USER
WorkingDirectory=/path/to/ms-pred/webui

# All environment variables (paths, secrets, SMTP) live in this file,
# which is owned by USER and never committed to git.
# Copy deploy/iceberg-webui-env.example to ~/.iceberg-webui-env and fill it in.
EnvironmentFile=/home/USER/.iceberg-webui-env

ExecStart=/path/to/miniforge3/envs/ms-gen/bin/gunicorn \
  -w 2 -k gthread --threads 8 \
  -b 127.0.0.1:4285 wsgi:app

Restart=always
RestartSec=3
TimeoutStopSec=30

# Hardening (optional but good)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
